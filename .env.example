# Server only. Never prefix this key with VITE_.
MONOROUTER_API_KEY=
MONOROUTER_MODEL=
MONOROUTER_BASE_URL=https://monogpt.kr/api/monorouter/v1
FREE_DAILY_LIMIT=3
# Vercel server only. Store the complete service-account JSON as an encrypted secret.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=ai-easynews

# Local Firebase emulators only. Ignored in production builds.
VITE_USE_FIREBASE_EMULATORS=true

# Production Firebase web app configuration (Firebase Console > Project settings).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=

# Optional monthly plan. Checkout stays closed until an actual product is configured.
ENABLE_DEMO_SUBSCRIPTIONS=false
REVENUECAT_API_KEY=
REVENUECAT_ENTITLEMENT_ID=
REVENUECAT_PURCHASE_URL=
SUBSCRIPTION_MONTHLY_KRW=

# Empty when using Vite proxy / Firebase Hosting on the same origin.
# For a separately hosted frontend use the deployed Cloud Function base URL.
VITE_API_BASE_URL=

# Shared secret for POST /api/cron/collect, called by .github/workflows/collect-news.yml.
# Set the same value as the GitHub repository secret CRON_SECRET (server only).
CRON_SECRET=

# NAVER API HUB credentials for the scheduled news collector (server only).
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
# Enable only when using the local API as the collector for a shared Firestore.
LOCAL_NEWS_COLLECTOR=false

# Legacy NAVER Developers Search credentials, if already issued.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Comma-separated RSS feeds you are permitted to use.
NEWS_RSS_FEEDS=
